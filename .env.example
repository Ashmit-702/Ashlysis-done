# Copy to .env for local use (never commit .env). On Render, set these in Environment.
GROQ_API_KEY=your_groq_key_here
# Optional extra Groq keys for rotation: GROQ_API_KEY_2=..., GROQ_API_KEY_3=...  (or GROQ_API_KEYS=key1,key2)
GEMINI_API_KEY=your_gemini_key_here
# Optional model overrides (only if a model is retired):
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GEMINI_MODEL=gemini-3.8-flash
